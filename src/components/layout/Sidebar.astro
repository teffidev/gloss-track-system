---
import { Image } from "astro:assets";
import { hasPermission } from "@/lib/permissions";
import icono from "../../../public/icono.png";

const pathname = Astro.url.pathname;
const user = Astro.locals.user;
---

<aside
  class="fixed left-0 top-0 h-screen w-65 bg-sidebar text-white flex flex-col justify-between p-6">
  <div>
    <div class="mb-10 flex items-center gap-3">
      <Image
        src={icono}
        alt="Gloss Track"
        width={50}
        height={50}
        class="rounded-full"
      />

      <div>
        <h1 class="text-lg font-bold">Gloss Track</h1>
        <p class="text-sm text-gray-400">Inventory System</p>
      </div>
    </div>

    <nav class="flex flex-col gap-2">
      <a
        href="/dashboard"
        class={`rounded-xl px-4 py-3 transition ${
          pathname === "/dashboard"
            ? "bg-primary text-white"
            : "hover:bg-white/10"
        }`}>
        Dashboard
      </a>

      {
        hasPermission(user.role, "products", "view") && (
          <a
            href="/products"
            class={`rounded-xl px-4 py-3 transition ${
              pathname === "/products"
                ? "bg-primary text-white"
                : "hover:bg-white/10"
            }`}>
            Products
          </a>
        )
      }

      {
        hasPermission(user.role, "suppliers", "view") && (
          <a
            href="/suppliers"
            class={`rounded-xl px-4 py-3 transition ${
              pathname === "/suppliers"
                ? "bg-primary text-white"
                : "hover:bg-white/10"
            }`}>
            Suppliers
          </a>
        )
      }

      {
        hasPermission(user.role, "users", "view") && (
          <a
            href="/users"
            class={`rounded-xl px-4 py-3 transition ${
              pathname === "/users"
                ? "bg-primary text-white"
                : "hover:bg-white/10"
            }`}>
            Users
          </a>
        )
      }

      <a
        href="/settings"
        class={`rounded-xl px-4 py-3 transition ${
          pathname === "/settings"
            ? "bg-primary text-white"
            : "hover:bg-white/10"
        }`}>
        Settings
      </a>
    </nav>
  </div>

  <button
    id="logout-button"
    class="rounded-xl bg-primary px-4 py-3 font-medium hover:opacity-90 transition">
    Logout
  </button>
</aside>

<script type="module">
  import { authClient } from "/src/lib/auth-client.ts";

  const logoutButton = document.querySelector("#logout-button");

  logoutButton?.addEventListener("click", async () => {
    await authClient.signOut();

    window.location.href = "/login";
  });
</script>
