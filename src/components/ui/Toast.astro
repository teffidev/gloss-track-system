<div
  id="toast"
  class="fixed right-6 top-6 z-50 hidden rounded-2xl bg-sidebar px-5 py-4 text-white shadow-xl">
  Toast Message
</div>

<script>
  window.showToast = (message) => {
    const toast = document.querySelector("#toast");

    if (!toast) return;

    toast.textContent = message;

    toast.classList.remove("hidden");

    setTimeout(() => {
      toast.classList.add("hidden");
    }, 3000);
  };
</script>
