---
import AppLayout from "@/layouts/AppLayout.astro";
---

<AppLayout title="Dashboard">
  <div class="grid grid-cols-3 gap-6">
    <div class="rounded-2xl bg-white p-6 shadow-sm">
      <p class="text-text-secondary">Total Products</p>

      <h3 class="mt-2 text-3xl font-bold">124</h3>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm">
      <p class="text-text-secondary">Low Stock</p>

      <h3 class="mt-2 text-3xl font-bold text-stock-low-text">12</h3>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm">
      <p class="text-text-secondary">Suppliers</p>

      <h3 class="mt-2 text-3xl font-bold">8</h3>
    </div>
  </div>
</AppLayout>
