---
import AppLayout from "@/layouts/AppLayout.astro";
import { prisma } from "@/lib/prisma";

const search = Astro.url.searchParams.get("search") || "";
const page = Number(Astro.url.searchParams.get("page") || "1");
const take = 5;
const skip = (page - 1) * take;

const suppliers = await prisma.supplier.findMany({
  where: {
    name: {
      contains: search,
      mode: "insensitive",
    },
  },

  include: {
    products: true,
  },

  orderBy: {
    createdAt: "desc",
  },

  take,
  skip,
});

const totalSuppliers = await prisma.supplier.count({
  where: {
    name: {
      contains: search,
      mode: "insensitive",
    },
  },
});

const totalPages = Math.ceil(totalSuppliers / take);
---

<AppLayout title="Suppliers">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">Suppliers</h1>

      <p class="mt-1 text-text-secondary">Manage product suppliers</p>
    </div>

    <a
      href="/suppliers/new"
      class="rounded-xl bg-primary px-5 py-3 font-medium text-white">
      New Supplier
    </a>
  </div>

  <form class="mt-6">
    <div class="flex gap-4">
      <input
        type="text"
        name="search"
        value={search}
        placeholder="Search supplier..."
        class="w-full rounded-xl border border-border bg-white px-4 py-3"
      />

      <button type="submit" class="rounded-xl bg-primary px-5 py-3 text-white">
        Search
      </button>
    </div>
  </form>

  <div class="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm">
    <table class="w-full">
      <thead class="border border-border bg-gray-50">
        <tr>
          <th class="px-6 py-4 text-left"> Name </th>
          <th class="px-6 py-4 text-left"> Email </th>
          <th class="px-6 py-4 text-left"> Phone </th>
          <th class="px-6 py-4 text-left"> Products </th>
          <th class="px-6 py-4 text-left"> Actions </th>
        </tr>
      </thead>

      <tbody>
        {
          suppliers.map((supplier) => (
            <tr class="border border-border">
              <td class="px-6 py-4">{supplier.name}</td>
              <td class="px-6 py-4">{supplier.email || "-"}</td>
              <td class="px-6 py-4">{supplier.phone || "-"}</td>
              <td class="px-6 py-4">{supplier.products.length}</td>
              <td class="px-6 py-4">
                <div class="flex gap-3">
                  <a
                    href={`/suppliers/${supplier.id}`}
                    class="rounded-lg border border-border px-3 py-2">
                    Edit
                  </a>

                  <button
                    class="delete-button rounded-lg bg-red-100 px-3 py-2 text-red-600"
                    data-id={supplier.id}>
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="my-4 mx-6 mt-8 flex items-center justify-center gap-2">
      <p class="text-sm text-text-secondary">
        Page {page} of {totalPages}
      </p>

      <div class="flex gap-2">
        {
          page > 1 && (
            <a
              href={`/suppliers?page=${page - 1}&search=${search}`}
              class="rounded-lg border border-primary text-primary font-medium bg-white px-4 py-2 hover:bg-gray-100">
              Previous
            </a>
          )
        }

        {
          page < totalPages && (
            <a
              href={`/suppliers?page=${page + 1}&search=${search}`}
              class="rounded-lg border border-primary text-primary font-medium bg-white px-8 py-2 hover:bg-gray-100">
              Next
            </a>
          )
        }
      </div>
    </div>
  </div>
</AppLayout>

<script>
  declare global {
    interface Window {
      showToast: (message: string) => void;
    }
  }
  const deleteButtons = document.querySelectorAll(".delete-button");

  deleteButtons.forEach((button) => {
    button.addEventListener("click", async (event) => {
      const targetButton = event.currentTarget as HTMLButtonElement;
      const id = targetButton.dataset.id;

      if (!id) return;

      const confirmed = confirm(
        "Are you sure you want to delete this supplier?"
      );

      if (!confirmed) return;

      const response = await fetch(`/api/suppliers/${id}`, {
        method: "DELETE",
      });

      if (response.ok) {
        window.showToast("Supplier deleted successfully");

        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        alert("Failed to delete supplier");
      }
    });
  });
</script>
