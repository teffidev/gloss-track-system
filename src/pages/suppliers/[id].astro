---
import AppLayout from "@/layouts/AppLayout.astro";
import { prisma } from "@/lib/prisma";

const supplier = await prisma.supplier.findUnique({
  where: {
    id: Astro.params.id,
  },

  include: {
    products: true,
  },
});

if (!supplier) {
  return Astro.redirect("/suppliers");
}
---

<AppLayout title="Edit Supplier">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold">Edit Supplier</h1>
    <p class="mt-1 text-text-secondary">Update supplier information</p>

    <form
      id="edit-supplier-form"
      class="mt-8 rounded-2xl bg-white p-8 shadow-sm">
      <div class="grid gap-6">
        <input
          type="text"
          name="name"
          value={supplier.name}
          class="w-full rounded-xl border border-border bg-white px-4 py-3 outline-none focus:border-primary"
        />

        <input
          type="email"
          name="email"
          value={supplier.email || ""}
          class="w-full rounded-xl border border-border bg-white px-4 py-3 outline-none focus:border-primary"
        />

        <input
          type="text"
          name="phone"
          value={supplier.phone || ""}
          class="w-full rounded-xl border border-border bg-white px-4 py-3 outline-none focus:border-primary"
        />

        <div class="flex space-between justify-center items-center gap-3">
          <a
            href="/suppliers"
            class="rounded-xl bg-sidebar px-8 py-3 text-white font-medium hover:opacity-90 transition inline-block text-center">
            Cancel
          </a>

          <button
            type="submit"
            class="rounded-xl bg-primary px-5 py-3 text-white">
            Save Changes
          </button>
        </div>
      </div>
    </form>
    <div class="mt-10">
      <h2 class="text-xl font-semibold">Related Products</h2>

      <div class="mt-4 overflow-hidden rounded-2xl bg-white shadow-sm">
        <table class="w-full">
          <thead class="border border-border bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left"> Product </th>
              <th class="px-6 py-4 text-left"> SKU </th>
              <th class="px-6 py-4 text-left"> Stock </th>
              <th class="px-6 py-4 text-right"> Action </th>
            </tr>
          </thead>

          <tbody>
            {
              supplier.products.map((product) => (
                <tr class="border-b border-border">
                  <td class="px-6 py-4">{product.name}</td>

                  <td class="px-6 py-4">{product.sku}</td>

                  <td class="px-6 py-4">{product.stock}</td>

                  <td class="px-6 py-4 text-right">
                    <a
                      href={`/products/${product.id}`}
                      class="rounded-lg bg-primary/10 px-4 py-2 text-sm font-semibold text-primary capitalize hover:bg-primary hover:text-white">
                      View Product
                    </a>
                  </td>
                </tr>
              ))
            }

            {
              supplier.products.length === 0 && (
                <tr>
                  <td
                    colspan="4"
                    class="px-6 py-8 text-center text-textSecondary">
                    No related products
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AppLayout>

<script define:vars={{ id: supplier.id }}>
  const form = document.querySelector("#edit-supplier-form");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    const payload = {
      name: formData.get("name"),
      email: formData.get("email"),
      phone: formData.get("phone"),
    };

    const response = await fetch(`/api/suppliers/${id}`, {
      method: "PUT",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify(payload),
    });

    if (response.ok) {
      window.showToast("Supplier updated successfully");

      setTimeout(() => {
        window.location.href = "/suppliers";
      }, 1000);
    }
  });
</script>
