---
import AppLayout from "@/layouts/AppLayout.astro";
import { hasPermission } from "@/lib/permissions";
import { prisma } from "@/lib/prisma";

const suppliers = await prisma.supplier.findMany();

if (!hasPermission(Astro.locals.user.role, "products", "create")) {
  return Astro.redirect("/dashboard");
}
---

<AppLayout title="New Product">
  <div class="max-w-5xl mx-auto">
    <div>
      <h1 class="text-3xl font-bold">Create Product</h1>
      <p class="mt-1 text-text-secondary">
        Add a new product to your inventory
      </p>
    </div>

    <form id="product-form" class="mt-8 rounded-2xl bg-white p-8 shadow-sm">
      <div class="grid gap-6">
        <div>
          <label class="mb-2 block text-sm font-medium"> Product Name </label>
          <input
            type="text"
            name="name"
            required
            class="w-full rounded-xl border border-border px-4 py-3 outline-none focus:border-primary"
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium"> SKU </label>
          <input
            type="text"
            name="sku"
            required
            class="w-full rounded-xl border border-border px-4 py-3 outline-none focus:border-primary"
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium"> Price </label>
          <input
            type="number"
            name="price"
            required
            min="0"
            step="0.01"
            class="w-full rounded-xl border border-border px-4 py-3 outline-none focus:border-primary"
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium"> Supplier </label>

          <select
            name="supplierId"
            class="w-full rounded-xl border border-border px-4 py-3 outline-none focus:border-primary">
            <option value=""> Select supplier </option>

            {
              suppliers.map((supplier) => (
                <option value={supplier.id}>{supplier.name}</option>
              ))
            }
          </select>
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium"> Stock </label>
          <input
            type="number"
            name="stock"
            required
            min="0"
            class="w-full rounded-xl border border-border px-4 py-3 outline-none focus:border-primary"
          />
        </div>

        <div class="flex space-between justify-center items-center gap-3">
          <a
            href="/products"
            class="rounded-xl bg-sidebar px-8 py-3 text-white font-medium hover:opacity-90 transition inline-block text-center">
            Cancel
          </a>
          <button
            type="submit"
            class="rounded-xl bg-primary px-8 py-3 text-white font-medium hover:opacity-90 transition">
            Create Product
          </button>
        </div>
      </div>
    </form>
  </div>
</AppLayout>

<script>
  // 1. Declaramos la extensión de la interfaz Window para que TypeScript la reconozca
  declare global {
    interface Window {
      showToast: (message: string) => void;
    }
  }

  const form = document.querySelector(
    "#product-form"
  ) as HTMLFormElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const targetForm = event.currentTarget as HTMLFormElement;
    const formData = new FormData(targetForm);

    const payload = {
      name: formData.get("name"),
      sku: formData.get("sku"),
      price: Number(formData.get("price")),
      stock: Number(formData.get("stock")),
      supplierId: formData.get("supplierId") || null,
    };

    const response = await fetch("/api/products/", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    if (response.ok) {
      // 2. Ahora puedes usarlo libremente sin errores de compilación ts(2339)
      window.showToast("Product created successfully");

      setTimeout(() => {
        window.location.href = "/products";
      }, 1000);
    } else {
      alert("Failed to create product");
    }
  });
</script>
