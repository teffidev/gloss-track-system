---
import AppLayout from "@/layouts/AppLayout.astro";
import { hasPermission } from "@/lib/permissions";
import { prisma } from "@/lib/prisma";

const search = Astro.url.searchParams.get("search") || "";

const page = Number(Astro.url.searchParams.get("page") || "1");

const take = 5;

const skip = (page - 1) * take;

const canCreate = hasPermission(Astro.locals.user.role, "products", "create");

const canDelete = hasPermission(Astro.locals.user.role, "products", "delete");

const products = await prisma.product.findMany({
  where: {
    OR: [
      {
        name: {
          contains: search,
          mode: "insensitive",
        },
      },

      {
        sku: {
          contains: search,
          mode: "insensitive",
        },
      },
    ],
  },

  include: {
    supplier: true,
  },
  orderBy: {
    createdAt: "desc",
  },

  take,
  skip,
});

const totalProducts = await prisma.product.count({
  where: {
    OR: [
      {
        name: {
          contains: search,
          mode: "insensitive",
        },
      },

      {
        sku: {
          contains: search,
          mode: "insensitive",
        },
      },
    ],
  },
});

const totalPages = Math.ceil(totalProducts / take);

const checkLowStock = (stock: number) => stock <= 5;
---

<AppLayout title="Products">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">Products</h1>

      <p class="mt-1 text-text-secondary">Manage your inventory products</p>
    </div>

    {
      canCreate && (
        <a
          href="/products/new"
          class="rounded-xl bg-primary px-8 py-3 text-white font-medium hover:opacity-90 transition">
          New Product
        </a>
      )
    }
  </div>

  <form class="mt-6">
    <div class="flex gap-4">
      <input
        type="text"
        name="search"
        value={search}
        placeholder="Search products by name or SKU..."
        class="w-full rounded-xl border border-border bg-white px-4 py-3 outline-none focus:border-primary"
      />

      <button
        type="submit"
        class="rounded-xl bg-primary px-5 py-3 text-white font-medium">
        Search
      </button>
    </div>
  </form>

  <div class="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm">
    <table class="w-full">
      <thead class="border-b border-border bg-gray-50">
        <tr>
          <th class="px-6 py-4 text-left text-sm font-semibold"> Product </th>
          <th class="px-6 py-4 text-left text-sm font-semibold"> SKU </th>
          <th class="px-6 py-4 text-left text-sm font-semibold"> Price </th>
          <th class="px-6 py-4 text-left text-sm font-semibold"> Supplier </th>
          <th class="px-6 py-4 text-left text-sm font-semibold"> Stock </th>
          <th class="px-6 py-4 text-left text-sm font-semibold"> Status </th>
          <th class="px-6 py-4 text-left text-sm font-semibold"> Actions </th>
        </tr>
      </thead>
      <tbody>
        {
          products.map((product) => (
            <tr class="border-b border-border hover:bg-gray-50 transition">
              <td class="px-6 py-4 font-medium"> {product.name} </td>
              <td class="px-6 py-4 text-textSecondary"> {product.sku} </td>
              <td class="px-6 py-4"> ${product.price} </td>
              <td class="px-6 py-4">
                {" "}
                {product.supplier?.name || "No supplier"}{" "}
              </td>
              <td class="px-6 py-4"> {product.stock} </td>
              <td class="px-6 py-4">
                {checkLowStock(product.stock) ? (
                  <span class="rounded-full bg-stock-low-bg px-3 py-1 text-sm font-medium text-stock-low-text">
                    Low Stock
                  </span>
                ) : (
                  <span class="rounded-full bg-stock-ok-bg px-3 py-1 text-sm font-medium text-stock-ok-text">
                    In Stock
                  </span>
                )}
              </td>
              <td class="px-6 py-4">
                <div class="flex gap-3">
                  <a
                    href={`/products/${product.id}`}
                    class="rounded-lg border border-border px-3 py-2 text-sm hover:bg-gray-100 transition">
                    Edit
                  </a>

                  {canDelete && (
                    <button
                      class="delete-button rounded-lg bg-red-100 px-3 py-2 text-sm text-red-600 hover:bg-red-200 transition"
                      data-id={product.id}>
                      Delete
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div class="my-4 mx-6 mt-8 flex items-center justify-center gap-2">
      <p class="text-sm text-text-secondary">
        Page {page} of {totalPages}
      </p>

      <div class="flex gap-2">
        {
          page > 1 && (
            <a
              href={`/products?page=${page - 1}&search=${search}`}
              class="rounded-lg border border-primary text-primary font-medium bg-white px-4 py-2 hover:bg-gray-100">
              Previous
            </a>
          )
        }

        {
          page < totalPages && (
            <a
              href={`/products?page=${page + 1}&search=${search}`}
              class="rounded-lg border border-primary text-primary font-medium bg-white px-8 py-2 hover:bg-gray-100">
              Next
            </a>
          )
        }
      </div>
    </div>
  </div>
</AppLayout>

<script>
  // Solución: Usamos un selector de tipo específico en querySelectorAll
  const deleteButtons =
    document.querySelectorAll<HTMLButtonElement>(".delete-button");

  deleteButtons.forEach((button) => {
    button.addEventListener("click", async (event) => {
      // Usar event.currentTarget asegura el tipo correcto del botón presionado
      const targetButton = event.currentTarget as HTMLButtonElement;
      const id = targetButton.dataset.id;

      if (!id) return; // Validación de seguridad por si el ID no existe

      const confirmed = confirm(
        "Are you sure you want to delete this product?"
      );
      if (!confirmed) return;

      const response = await fetch(`/api/products/${id}`, {
        method: "DELETE",
      });

      if (response.ok) {
        window.showToast("Product deleted successfully");

        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        alert("Failed to delete product");
      }
    });
  });
</script>
